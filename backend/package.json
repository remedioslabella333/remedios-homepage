{
  "name": "remedios-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply remedios-homepage-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply remedios-homepage-db --remote",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
